FROM ghcr.io/kegustafsson/signalk-server-base:latest

ARG TAG

# The server installs its bundled packages, App Store plugins and webapps
# with pnpm, so the image carries it whether or not the base image does.
# Some base images end as user node, which cannot write the global prefix.
USER root
RUN command -v pnpm >/dev/null || (npm install -g pnpm@11 && npm cache clean --force)

USER node
WORKDIR /home/node/signalk

RUN mkdir -p /home/node/.signalk/ /home/node/signalk/ \
  && npm config rm proxy \
  && npm config rm https-proxy \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 60000 \
  && npm config set fetch-retry-maxtimeout 120000 \
  && npm config set registry "https://registry.npmjs.org/" \
  && npm config set @backup:registry "https://registry.yarnpkg.com/" \
  && npm cache clean -f

# pnpm runs dependency install scripts only for approved packages.
# @canboat/canboatjs builds its native SocketCAN addon from an "install"
# script and ships no prebuilt binaries; it turns a failed build into a log
# line and pnpm skips failing scripts, so the addon is asserted afterwards.
# Other dependencies' scripts are not needed at runtime. The image bundles
# exactly the versions the server declares, so pnpm's release-age gate is
# off; it would otherwise silently pick older versions of freshly released
# bundled plugins. node_modules holds hard links into the pnpm store, so
# the store is removed once the install is done, together with the
# node-gyp headers that building the addon leaves in ~/.cache.
RUN printf '%s\n' \
       'strictDepBuilds: false' \
       'allowBuilds:' \
       "  '@canboat/canboatjs': true" \
       "  '@serialport/bindings-cpp': true" \
       'minimumReleaseAge: 0' > pnpm-workspace.yaml \
  && printf '{"name":"signalk","private":true}\n' > package.json \
  && pnpm add "signalk-server@$TAG" \
  # Servers that predate module-resolution lookup (dist/bundled-packages.js)
  # expect the admin UI and bundled plugins under <server>/node_modules/.
  # pnpm places those as siblings of the server inside its virtual store
  # directory, so a symlink to that directory makes the old lookup work.
  # pnpm only keeps bin shims for package scripts in <server>/node_modules,
  # and the image never runs those, so the directory is replaced.
  && if [ ! -f node_modules/signalk-server/dist/bundled-packages.js ]; then \
       real=$(readlink -f node_modules/signalk-server) \
       && rm -rf "$real/node_modules" \
       && ln -s .. "$real/node_modules"; \
     fi \
  && rm -rf "$(pnpm store path)" "$HOME/.cache" \
  && if [ -z "$(find node_modules -path '*/@canboat/canboatjs/build/Release/canSocket.node' -print -quit)" ]; then \
       echo "canSocket.node missing: the canboatjs native CAN addon did not build" >&2; \
       exit 1; \
     fi

COPY --chown=node:node --chmod=755 docker/startup.sh startup.sh

ENV IS_IN_DOCKER=true
WORKDIR /home/node/.signalk
EXPOSE 3000
# tini as PID 1 forwards the SIGTERM of "docker stop" to the server; node
# as PID 1 would ignore it and the container would be killed after 10 s.
ENTRYPOINT ["tini", "--", "/home/node/signalk/startup.sh"]
