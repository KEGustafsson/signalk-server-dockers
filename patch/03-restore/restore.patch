From ed7b004777602a3b3056fa393e62f5652ef814f1 Mon Sep 17 00:00:00 2001
From: KEGustafsson <ke.gustafsson@gmail.com>
Date: Tue, 10 Nov 2026 20:06:13 +0000
Subject: [PATCH 1/2] feat(server-api): add FullSignalK.restoreDelta

Adds values to the full tree without emitting a delta or stamping
source freshness, for values saved by an earlier run.
---
 packages/server-api/src/fullsignalk.test.ts | 33 +++++++++++++++++++++
 packages/server-api/src/fullsignalk.ts      | 27 +++++++++++++++++
 2 files changed, 60 insertions(+)

diff --git a/packages/server-api/src/fullsignalk.test.ts b/packages/server-api/src/fullsignalk.test.ts
index 726ebdee10..93fb473593 100644
--- a/packages/server-api/src/fullsignalk.test.ts
+++ b/packages/server-api/src/fullsignalk.test.ts
@@ -760,4 +760,37 @@ describe('Mixed source shapes for one NMEA0183 source', function () {
     expect(entry.talker).to.equal('II')
     expect(entry.sentences).to.have.property('HDM', '2016-07-28T18:18:47.000Z')
   })
+
+  it('restoreDelta adds values without emitting or marking the source seen', function () {
+    const fullSignalK = new FullSignalK('urn:mrn:imo:mmsi:200000000')
+    const emitted: unknown[] = []
+    fullSignalK.on('delta', (d) => emitted.push(d))
+    const lastModified = Date.parse('2026-11-10T19:00:00.000Z')
+
+    fullSignalK.restoreDelta(
+      {
+        context: 'vessels.urn:mrn:imo:mmsi:200000000',
+        updates: [
+          {
+            $source: 'can0.35',
+            timestamp: '2026-11-10T18:59:00.000Z',
+            values: [{ path: 'tanks.fuel.0.currentLevel', value: 0.62 }]
+          }
+        ]
+      },
+      lastModified
+    )
+
+    const leaf =
+      fullSignalK.retrieve().vessels['urn:mrn:imo:mmsi:200000000'].tanks.fuel[
+        '0'
+      ].currentLevel
+    expect(leaf.value).to.equal(0.62)
+    expect(leaf.timestamp).to.equal('2026-11-10T18:59:00.000Z')
+    expect(emitted).to.have.length(0)
+    expect(fullSignalK.sourceMeta).to.not.have.property('can0.35')
+    expect(
+      fullSignalK.lastModifieds['vessels.urn:mrn:imo:mmsi:200000000']
+    ).to.equal(lastModified)
+  })
 })
diff --git a/packages/server-api/src/fullsignalk.ts b/packages/server-api/src/fullsignalk.ts
index ca15dc3499..6b1d76fd70 100644
--- a/packages/server-api/src/fullsignalk.ts
+++ b/packages/server-api/src/fullsignalk.ts
@@ -458,6 +458,33 @@ export class FullSignalK extends EventEmitter {
     }
   }
 
+  /**
+   * Add values saved by an earlier run without emitting them as a delta
+   * or marking their sources as seen, so nothing treats them as live data.
+   */
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  restoreDelta(delta: Record<string, any>, lastModified: number): void {
+    const context = findContext(this.root, delta.context)
+    if (!context || !Array.isArray(delta.updates)) {
+      return
+    }
+    for (const update of delta.updates) {
+      if (Array.isArray(update.values)) {
+        addValues(
+          context,
+          delta.context,
+          update.source || update['$source'],
+          update.timestamp,
+          update.values
+        )
+      }
+    }
+    this.lastModifieds[delta.context] = Math.max(
+      this.lastModifieds[delta.context] ?? 0,
+      lastModified
+    )
+  }
+
   updateLastModified(contextKey: string): void {
     this.lastModifieds[contextKey] = Date.now()
   }

From e9dd2d9402ba9b4cd3623f8673542ae1de5583d7 Mon Sep 17 00:00:00 2001
From: KEGustafsson <ke.gustafsson@gmail.com>
Date: Tue, 10 Nov 2026 20:06:13 +0000
Subject: [PATCH 2/2] feat: restore cached values after a clean restart

With the new restoreOwnData setting the server saves its own vessel's
cached values when it stops cleanly (admin restart button, reboot,
SIGTERM) and restores them once on the next start, keeping their
original timestamps. restoreOtherVessels also keeps other vessels that
are newer than pruneContextsMinutes.

Restored values go into the delta cache and the full tree only, not
through the delta chain, so plugins and the priority engine do not see
them as live data. The file is deleted when read, so after a power cut
the server starts empty instead of loading values from an older run.

Refs SignalK/signalk-server#1864
