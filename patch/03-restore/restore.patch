+          context: delta.context,
+          source: update.source,
+          $source: update.$source,
+          timestamp: update.timestamp,
+          path: pathValue.path,
+          value: pathValue.value,
+          state: pathValue.state,
+          isMeta: false
+        } as NormalizedDelta)
+      }
+    }
+    this.lastModifieds[delta.context] = Math.max(
+      this.lastModifieds[delta.context] ?? 0,
+      lastModified
+    )
+  }
