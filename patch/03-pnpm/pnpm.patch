+import { expect } from 'chai'
+import { execFileSync } from 'child_process'
+import fs from 'fs'
+import os from 'os'
+import path from 'path'
+import { getBundledPnpm, PNPM_APP_STORE_SETTINGS } from '../src/modules'
+
+// The App Store's pnpm reads the pnpm config of the user that the server runs
+// as, which must not move packages out of the config directory's node_modules
+describe('App Store pnpm settings', () => {
+  let home: string
+
+  beforeEach(() => {
+    home = fs.mkdtempSync(path.join(os.tmpdir(), '_skservertest_pnpmrc'))
+    fs.mkdirSync(path.join(home, 'pnpm'))
+    fs.writeFileSync(
+      path.join(home, 'pnpm', 'config.yaml'),
+      'enableGlobalVirtualStore: true\n'
+    )
+  })
+
+  afterEach(() => {
+    fs.rmSync(home, { recursive: true, force: true })
+  })
+
+  const globalVirtualStore = (settings: string[]) =>
+    execFileSync(
+      process.execPath,
+      [
+        getBundledPnpm().bin,
+        ...settings,
+        'config',
+        'get',
+        'enableGlobalVirtualStore'
+      ],
+      {
+        cwd: home,
+        encoding: 'utf8',
+        env: { ...process.env, XDG_CONFIG_HOME: home }
+      }
+    ).trim()
+
+  it('keeps packages out of a global virtual store that the user turned on', () => {
+    expect(globalVirtualStore([])).to.equal('true')
+    expect(globalVirtualStore(PNPM_APP_STORE_SETTINGS)).to.equal('false')
+  })
+})

From 770c85419b0e2be61ec914f1b08dfca3d8953552 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 20:05:56 +0000
Subject: [PATCH 18/24] build: turn off pnpm's release age gate in the monorepo

pnpm 11 holds a version back for a day after it is published, and
applies that to a frozen lockfile as well, so test, release and image
builds failed for a day after a dependency update picked up a fresh
version, whether a bundled plugin, pnpm itself or a Dependabot bump.
What those builds install is the committed lockfile, which pull
requests review, so versions now install as soon as they are
published, as in the App Store.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Tc38h7UaqvAcPgWkZK3Fcj
---
 pnpm-workspace.yaml | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/pnpm-workspace.yaml b/pnpm-workspace.yaml
index 30545fc991..f381db9744 100644
--- a/pnpm-workspace.yaml
+++ b/pnpm-workspace.yaml
@@ -31,8 +31,9 @@ allowBuilds:
   # Selects a React Native storage backend
   storage-engine: false
 
-# Packages published by the Signal K and Canboat projects are released and
-# adopted together, so they are not held back by minimumReleaseAge.
-minimumReleaseAgeExclude:
-  - '@signalk/*'
-  - '@canboat/*'
+# Versions install as soon as they are published, as in the App Store. What
+# CI, release and image builds install is the committed lockfile, which pull
+# requests review; pnpm's one-day release age gate, which it also applies to a
+# frozen lockfile, would only hold back a release or a dependency update that
+# picks up a version published the same day.
+minimumReleaseAge: 0

From c1fcbb742bfafaa8caa1274fecfd4e8b3caefdbe Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 20:06:36 +0000
Subject: [PATCH 19/24] fix(appstore): settle an interrupted rebuild when the
 server starts

The backup of an npm-built node_modules was only put back by the next
App Store operation, so after a power cut during the rebuild plugins
stayed missing. The server now settles it at startup, before anything
loads from node_modules.

Whether a rebuild completed is read from the manifest that pnpm writes
once every package is linked, rather than from its exit code alone, so
a command that installs nothing, or a rebuild cut short however it
ended, puts the user's installation back. Trees are renamed out of the
way before they are deleted, and at startup the deletion finishes in
the background. Once a rebuild has replaced the npm tree, npm's
package-lock.json, which describes that tree, goes with it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Tc38h7UaqvAcPgWkZK3Fcj
