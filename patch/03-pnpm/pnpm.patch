+import { expect } from 'chai'
+import fs from 'fs'
+import path from 'path'
+import { getBundledPnpm, PNPM_APP_STORE_SETTINGS } from '../src/modules'
+
+const workflow = fs.readFileSync(
+  path.join(__dirname, '..', '.github', 'workflows', 'plugin-ci.yml'),
+  'utf8'
