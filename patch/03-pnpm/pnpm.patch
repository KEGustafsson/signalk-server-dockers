+
+// Plugin CI installs a plugin the way the App Store will, so that a plugin
+// that installs there installs for its users too
+function appStoreInstall() {
+  const install = /npx --yes pnpm@(\d+) ((?:--config\.\S+ )+)add /.exec(
+    workflow
+  )
